# ── LLM Provider ────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=openai/gpt-oss-120b

# ── Angel One SmartAPI ──────────────────────────────────────────────────────────
ANGEL_API_KEY=your_angel_api_key_here
ANGEL_CLIENT_ID=your_angel_client_id_here
ANGEL_PASSWORD=your_trading_pin_here
ANGEL_TOTP_SECRET=your_base32_totp_secret_here

# ── News / Search ───────────────────────────────────────────────────────────────
SERPER_API_KEY=your_serper_api_key_here

# ── App Settings ─────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
DB_PATH=./data/trading.db
CACHE_DIR=./data/cache

# ── Paper Trading ────────────────────────────────────────────────────────────────
PAPER_TRADING=true          # set false only to enable live broker orders
DEFAULT_CAPITAL=100000      # INR – used for position sizing
RISK_PER_TRADE_PCT=1.0      # % of capital to risk per trade
